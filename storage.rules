rules_version = '2';

// ChurchMate Storage rules.
// Any signed-in user can view images (profile photos and book covers are shown
// throughout the app). Profile photos can only be written by their owner. Book
// covers are written by whoever is creating/editing that book (Firestore rules
// already restrict that to Youth Leaders). Event images were removed from the
// app, so there is no write access for them anymore.

service firebase.storage {
  match /b/{bucket}/o {

    match /profile_photos/{uid}.{ext} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Files are named "<bookId>_<timestamp>.<ext>" (unique per upload so a
    // replaced cover is never served from cache).
    match /book_covers/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Legacy: existing event images stay readable, no new uploads.
    match /event_images/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
